# توکن ربات تلگرام را از BotFather بگیرید و به‌جای مقدار زیر بگذارید
# آموزش ساخت ربات: در تلگرام به @BotFather پیام بدهید و دستور /newbot را بفرستید
BOT_TOKEN=توکن_ربات_را_اینجا_بگذارید

# کلید OpenRouter برای حالت مدل‌های رایگان (https://openrouter.ai/keys)
# در حالت custom از CUSTOM_API_KEY استفاده کنید
OPENROUTER_API_KEY=کلید_اوپن‌روتر_را_اینجا_بگذارید
# CUSTOM_API_KEY=کلید_اختصاصی_را_اینجا_بگذارید
